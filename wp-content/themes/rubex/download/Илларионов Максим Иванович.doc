}\cell\pard\intbl\itap1{\fs50\b \uc0\u1048 \uc0\u1083 \uc0\u1083 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1052 \uc0\u1072 \uc0\u1082 \uc0\u1089 \uc0\u1080 \uc0\u1084  \uc0\u1048 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1080 \uc0\u1095 }\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1052 \uc0\u1091 \uc0\u1078 \uc0\u1095 \uc0\u1080 \uc0\u1085 \uc0\u1072 , 30\uc0\u160 \uc0\u1083 \uc0\u1077 \uc0\u1090 , \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083 \uc0\u1089 \uc0\u1103  19 \uc0\u1086 \uc0\u1082 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1103  1992}\par\pard\intbl\sl260{\fs18 \par +7\uc0\u160 (950)\uc0\u160 8724595 {\cf1\emdash  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1086 \uc0\u1095 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1073  \uc0\u1089 \uc0\u1074 \uc0\u1103 \uc0\u1079 \uc0\u1080 }\par {{\field{\*\fldinst HYPERLINK "mailto:millarionov4@gmail.com"}{\fldrslt\ul millarionov4@gmail.com}}}}\par\pard\intbl\sl260{\fs18 \par \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1077 \uc0\u1090 : \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1082 \par \uc0\u1043 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 : \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103 , \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1091 : \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103 \par \uc0\u1053 \uc0\u1077  \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1077 \uc0\u1079 \uc0\u1076 \uc0\u1091 , \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1082 \uc0\u1080 \uc0\u1084  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 \uc0\u1084 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1046 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1088 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1072 }\cell\row\trowd\cellx6861\clvertalc\cellx9638\pard\intbl\itap1\sa100\sl280{\fs24\b \uc0\u1042 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1094 \uc0\u1086 \uc0\u1074 \uc0\u1097 \uc0\u1080 \uc0\u1082  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1077 \uc0\u1081 }\pard\intbl\itap1\sl260{\fs18 \par{\uc0\u1057 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 :  }\par\li300{\uc0\u8212   \uc0\u1044 \uc0\u1088 \uc0\u1091 \uc0\u1075 \uc0\u1086 \uc0\u1077 \par\uc0\u8212   \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1091 \uc0\u1090 \uc0\u1077 \uc0\u1088 }\par\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1047 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 : \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 , \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \par \uc0\u1043 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1100 , \uc0\u1089 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 , \uc0\u1075 \uc0\u1080 \uc0\u1073 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 , \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 , \uc0\u1074 \uc0\u1072 \uc0\u1093 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1081  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1076 \par \line\uc0\u1046 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1074  \uc0\u1087 \uc0\u1091 \uc0\u1090 \uc0\u1080  \uc0\u1076 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1085 \uc0\u1077  \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1077 \uc0\u1090  \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }}\cell \pard\intbl\itap1\qr{\fs32\qc\b 50\uc0\u160 000}\line{\fs18\sl260 \uc0\u1088 \uc0\u1091 \uc0\u1073 .}\par\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \emdash 10 \uc0\u1083 \uc0\u1077 \uc0\u1090  9 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1082 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2022 \emdash  \uc0\u1085 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1103 \uc0\u1097 \uc0\u1077 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103 \line 9 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\pard\intbl\itap1\par\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1054 \uc0\u1054 \uc0\u1054  "\uc0\u1053 \uc0\u1080 \uc0\u1050 " \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086  \uc0\u1056 \uc0\u1077 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1086  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1080 \uc0\u1079 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1080 \uc0\u1081 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1082 , rti-kursk.ru/}\par\pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1042 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1094 \uc0\u1086 \uc0\u1074 \uc0\u1097 \uc0\u1080 \uc0\u1082  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1077 \uc0\u1081 \par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1048 \uc0\u1079 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 /\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1077 \uc0\u1074  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1077 \uc0\u1081  \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1094 \uc0\u1072 \uc0\u1093 , \uc0\u1083 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1077 \uc0\u1081 .{\line}\uc0\u1055 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1080  \uc0\u1074 \uc0\u1079 \uc0\u1074 \uc0\u1077 \uc0\u1096 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1086  \uc0\u1088 \uc0\u1077 \uc0\u1094 \uc0\u1077 \uc0\u1087 \uc0\u1090 \uc0\u1091  \uc0\u1101 \uc0\u1083 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1077 \uc0\u1086 \uc0\u1073 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1084 \uc0\u1099 \uc0\u1093  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1080 \uc0\u1079 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1077 \uc0\u1081 .}\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1053 \uc0\u1086 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2020 \emdash  \uc0\u1054 \uc0\u1082 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2021\line 1 \uc0\u1075 \uc0\u1086 \uc0\u1076 }\cell\pard\intbl\itap1\sb250\par\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1040 \uc0\u1053 \uc0\u1050 \uc0\u1054 \uc0\u1056 , \uc0\u1082 \uc0\u1072 \uc0\u1076 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1081  \uc0\u1093 \uc0\u1086 \uc0\u1083 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1075 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1082 , www.ancor.ru}\par{\fs18 \uc0\u1059 \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1075 \uc0\u1080  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1072 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1050 \uc0\u1072 \uc0\u1076 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1077  \uc0\u1072 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072 }}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1091 \uc0\u1090 \uc0\u1077 \uc0\u1088 -\uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1090 \par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083  \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1077  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1073 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1072  Philips, \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072 \uc0\u1084  \uc0\u1084 \uc0\u1077 \uc0\u1083 \uc0\u1082 \uc0\u1086 \uc0\u1073 \uc0\u1099 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1081  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1080  \uc0\u1074  \uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1093  \uc0\u1069 \uc0\u1083 \uc0\u1100 \uc0\u1076 \uc0\u1086 \uc0\u1088 \uc0\u1072 \uc0\u1076 \uc0\u1086 . {\line}\uc0\u1042  \uc0\u1086 \uc0\u1073 \uc0\u1103 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1074 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083 \uc0\u1086  : \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1073 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1072  Philips \uc0\u1074  \uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1077 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1080  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1086 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1087 \uc0\u1086  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1072 \uc0\u1084  \uc0\u1080  \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1077 \uc0\u1081 \uc0\u1096 \uc0\u1072 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072 , \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1075  \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1074  \uc0\u1073 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1072  Philips \uc0\u1074  \uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1077 , \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1072  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1080 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1091  \uc0\u1089  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1102 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1081 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1072  \uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1072 , \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074  KPI, \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072 \uc0\u1084 , \uc0\u1086 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1074 \uc0\u1094 \uc0\u1086 \uc0\u1074  \uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1086  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1091  \uc0\u1073 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1072  \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1097 \uc0\u1100  \uc0\u1087 \uc0\u1088 \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 .}\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1052 \uc0\u1072 \uc0\u1088 \uc0\u1090  2017 \emdash  \uc0\u1054 \uc0\u1082 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2020\line 3 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072  8 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\pard\intbl\itap1\sb250\par\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1052 .\uc0\u1042 \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1086 -\uc0\u1069 \uc0\u1083 \uc0\u1100 \uc0\u1076 \uc0\u1086 \uc0\u1088 \uc0\u1072 \uc0\u1076 \uc0\u1086 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1082 , www.mvideo.ru}\par{\fs18 \uc0\u1069 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 , \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 , \uc0\u1073 \uc0\u1099 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 , \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1100 \uc0\u1102 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1099  \uc0\u1080  \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1041 \uc0\u1099 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 , \uc0\u1101 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 , \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1077  \uc0\u1086 \uc0\u1073 \uc0\u1086 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  (\uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1078 , \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 , \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1090 )}}\par {\fs18 \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1103 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1077 \uc0\u1090 \uc0\u1100  (\uc0\u1101 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 , \uc0\u1073 \uc0\u1099 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 )}}\par\li300{{\fs18 \uc0\u8226  \uc0\u1048 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1077 \uc0\u1090 -\uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 }}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1074 \uc0\u1077 \uc0\u1094 \par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1053 \uc0\u1077 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1085 \uc0\u1086  \uc0\u1073 \uc0\u1099 \uc0\u1083  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1099 \uc0\u1084  \uc0\u1074  \uc0\u1088 \uc0\u1077 \uc0\u1081 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1077  \uc0\u1089 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1074 \uc0\u1094 \uc0\u1086 \uc0\u1074  \uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1072 , \uc0\u1074 \uc0\u1099 \uc0\u1080 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1083  \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1084 \uc0\u1086 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081 }\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1082 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2015 \emdash  \uc0\u1054 \uc0\u1082 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2017\line 2 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072  1 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 }\cell\pard\intbl\itap1\sb250\par\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1054 \uc0\u1054 \uc0\u1054  \uc0\u1069 \uc0\u1083 \uc0\u1100 \uc0\u1076 \uc0\u1086 \uc0\u1088 \uc0\u1072 \uc0\u1076 \uc0\u1086 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1082 , www.eldorado.ru}\par{\fs18 \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1103 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1077 \uc0\u1090 \uc0\u1100  (DIY \uc0\u1080  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1099  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1084 \uc0\u1072 )}}\par\li300{{\fs18 \uc0\u8226  \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1077 \uc0\u1090 \uc0\u1100  (\uc0\u1101 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 , \uc0\u1073 \uc0\u1099 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 )}}\par\li300{{\fs18 \uc0\u8226  \uc0\u1048 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1077 \uc0\u1090 -\uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 }}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1074 \uc0\u1077 \uc0\u1094 -\uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1090 ; \uc0\u1057 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1089 \uc0\u1090 \par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1053 \uc0\u1072  \uc0\u1085 \uc0\u1072 \uc0\u1095 \uc0\u1072 \uc0\u1083 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083  \uc0\u1074  \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  "\uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1074 \uc0\u1094 \uc0\u1072 " \uc0\u1074  \uc0\u1090 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1080  3-\uc0\u1093  \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 , \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1083 \uc0\u1077  \uc0\u1095 \uc0\u1077 \uc0\u1075 \uc0\u1086  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1077 \uc0\u1083 \uc0\u1089 \uc0\u1103  \uc0\u1074  \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  "\uc0\u1057 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1089 \uc0\u1090 ".{\line}\uc0\u1042  \uc0\u1086 \uc0\u1073 \uc0\u1103 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1074 \uc0\u1094 \uc0\u1072  \uc0\u1074 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083 \uc0\u1086  : \uc0\u1086 \uc0\u1073 \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1087 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081 , \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 , \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1072  \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1082 \uc0\u1072  \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1080 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1077 , \uc0\u1074 \uc0\u1099 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1072  \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1080 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1091 .{\line}\uc0\u1057 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1072  : \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 , \uc0\u1086 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1074 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1074 (\uc0\u1086 \uc0\u1073 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1086 \uc0\u1074 )/\uc0\u1076 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1082 \uc0\u1080  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1072 , \uc0\u1074 \uc0\u1099 \uc0\u1074 \uc0\u1086 \uc0\u1079  \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1072 , \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1077 \uc0\u1084 \uc0\u1082 \uc0\u1072  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1072  \uc0\u1074  \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1090 (\uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1091 ), \uc0\u1086 \uc0\u1089 \uc0\u1091 \uc0\u1097 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1081 \uc0\u1082 \uc0\u1080  \uc0\u1084 \uc0\u1086 \uc0\u1073 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1080 .{\line}\uc0\u1044 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  : \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1091 \uc0\u1083 \uc0\u1103 \uc0\u1088 \uc0\u1085 \uc0\u1086  \uc0\u1087 \uc0\u1086 \uc0\u1087 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1102  \uc0\u1085 \uc0\u1072  \uc0\u1076 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1091  \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1096 \uc0\u1080 \uc0\u1093  \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1072 ; \uc0\u1074 \uc0\u1099 \uc0\u1080 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1083  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1082 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1091  \uc0\u1085 \uc0\u1086 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1084  10000 \uc0\u1088 \uc0\u1091 \uc0\u1073 . \uc0\u1074  \uc0\u1089 \uc0\u1086 \uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072 \uc0\u1084  \uc0\u1087 \uc0\u1072 \uc0\u1082 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 , \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1074  1 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1086 ; \uc0\u1074 \uc0\u1099 \uc0\u1080 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1083  \uc0\u1089 \uc0\u1086 \uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072 \uc0\u1084  \uc0\u1085 \uc0\u1072 \uc0\u1091 \uc0\u1096 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  Sony \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1080 \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1102  \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1077  5000 \uc0\u1088 \uc0\u1091 \uc0\u1073 .; \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1080 \uc0\u1083  \uc0\u1076 \uc0\u1080 \uc0\u1087 \uc0\u1083 \uc0\u1086 \uc0\u1084  \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1096 \uc0\u1077 \uc0\u1075 \uc0\u1086  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072 \uc0\u1084  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1093 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1082  \uc0\u1069 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1089  \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089  \uc0\u1079 \uc0\u1072  2016 \uc0\u1075 . \uc0\u1089 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1080  \uc0\u1057 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1074 .}\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1053 \uc0\u1086 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2011 \emdash  \uc0\u1057 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2015\line 3 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072  11 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\pard\intbl\itap1\sb250\par\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1057 \uc0\u1074 \uc0\u1103 \uc0\u1079 \uc0\u1085 \uc0\u1086 \uc0\u1081 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1082 , job.svyaznoy.ru/}\par{\fs18 \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1103 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1077 \uc0\u1090 \uc0\u1100  (\uc0\u1101 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 , \uc0\u1073 \uc0\u1099 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 )}}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1052 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1078 \uc0\u1077 \uc0\u1088  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072 \uc0\u1084 \par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1054 \uc0\u1073 \uc0\u1103 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  : \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1082 \uc0\u1072 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1081  \uc0\u1076 \uc0\u1080 \uc0\u1089 \uc0\u1094 \uc0\u1080 \uc0\u1087 \uc0\u1083 \uc0\u1080 \uc0\u1085 \uc0\u1099 , \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1105 \uc0\u1084  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1082 \uc0\u1072  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1072  \uc0\u1089 \uc0\u1086 \uc0\u1075 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1085 \uc0\u1086  \uc0\u1074 \uc0\u1085 \uc0\u1091 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1080 \uc0\u1084  \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1103 \uc0\u1084  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080 , \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1089  \uc0\u1094 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1102  \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1077 \uc0\u1081 \uc0\u1096 \uc0\u1077 \uc0\u1081  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1080  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1072  \uc0\u1080  \uc0\u1091 \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1075 , \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 \uc0\u1084  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 , \uc0\u1089 \uc0\u1073 \uc0\u1086 \uc0\u1088  \uc0\u1080 \uc0\u1085 \uc0\u1082 \uc0\u1072 \uc0\u1089 \uc0\u1089 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 , \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1100  \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1082 \uc0\u1072  \uc0\u1074  \uc0\u1089 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1085 \uc0\u1077  \uc0\u1080  \uc0\u1086 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1074 \uc0\u1089 \uc0\u1077 \uc0\u1093  \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1072 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1081 .{\line}{\line}\uc0\u1044 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  : \uc0\u1079 \uc0\u1072  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1085 \uc0\u1077 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1085 \uc0\u1086  \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1080 \uc0\u1083 \uc0\u1089 \uc0\u1103  \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1096 \uc0\u1080 \uc0\u1084  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1074 \uc0\u1094 \uc0\u1086 \uc0\u1084  \uc0\u1089 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1080  \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072  \uc0\u1079 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1077  \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1094 \uc0\u1086 , \uc0\u1090 \uc0\u1072 \uc0\u1082  \uc0\u1078 \uc0\u1077  \uc0\u1089 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1080  \uc0\u1089 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1082 \uc0\u1072 ; \uc0\u1074 \uc0\u1099 \uc0\u1080 \uc0\u1075 \uc0\u1088 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1079 \uc0\u1099  \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1077  2000, 5000; \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1091  \uc0\u1086 \uc0\u1090  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  philips( \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1074 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1088 , \uc0\u1084 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1082 \uc0\u1072 ); \uc0\u1083 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1084  2014 \uc0\u1074 \uc0\u1099 \uc0\u1080 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1083  \uc0\u1087 \uc0\u1086 \uc0\u1077 \uc0\u1079 \uc0\u1076 \uc0\u1082 \uc0\u1091  \uc0\u1074  \uc0\u1064 \uc0\u1088 \uc0\u1080 -\uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1082 \uc0\u1091  \uc0\u1086 \uc0\u1090  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  Lg. \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083  \uc0\u1085 \uc0\u1072  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1090 \uc0\u1086 \uc0\u1095 \uc0\u1082 \uc0\u1077 , \uc0\u1075 \uc0\u1076 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1089 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083 \uc0\u1086  \uc0\u1086 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1078 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1074 .}\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sl220{\fs22\uc0\u1057 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1085 \uc0\u1077 \uc0\u1077  \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1077 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 2011}\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1078 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1079 \uc0\u1085 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1091 \uc0\u1084  - \uc0\u1092 \uc0\u1080 \uc0\u1083 \uc0\u1080 \uc0\u1080 \uc0\u1083  \uc0\u1052 \uc0\u1048 \uc0\u1048 \uc0\u1058 }\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1058 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1093 \uc0\u1086 \uc0\u1079 \uc0\u1103 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086  , \uc0\u1058 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082  \uc0\u1101 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1084 \uc0\u1077 \uc0\u1093 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1082 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1050 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1074 \uc0\u1099 \uc0\u1077  \uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1047 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082 \uc0\u1086 \uc0\u1074 }\cell\pard\intbl\itap1\sl260{\fs18 \uc0\u1056 \uc0\u1091 \uc0\u1089 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  {\cf1\emdash  \uc0\u1056 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1081 }\par \uc0\u1040 \uc0\u1085 \uc0\u1075 \uc0\u1083 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  {\cf1\emdash  A1 \uc0\u8212  \uc0\u1053 \uc0\u1072 \uc0\u1095 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1081 }}\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell\pard\intbl\itap1\sb250\sl260{\fs18 {\cb5\chcfpat5\chcbpat5 \uc0\u1053 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1081 \uc0\u1082 \uc0\u1072 \~\uc0\u1055 \uc0\u1054 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1053 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1081 \uc0\u1082 \uc0\u1072 \~\uc0\u1055 \uc0\u1050 }  {\cb5\chcfpat5\chcbpat5 1\uc0\u1057 -\uc0\u1056 \uc0\u1072 \uc0\u1088 \uc0\u1091 \uc0\u1089 }  {\cb5\chcfpat5\chcbpat5 Windows\~8}  {\cb5\chcfpat5\chcbpat5 \uc0\u1040 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1077 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \~\uc0\u1089 \~\uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1054 \uc0\u1073 \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1087 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1050 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \~\uc0\u1089 \~\uc0\u1078 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1073 \uc0\u1072 \uc0\u1084 \uc0\u1080 \~\uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1053 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1058 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1080 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1054 \uc0\u1088 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 \~\uc0\u1085 \uc0\u1072 \~\uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 }  {\cb5\chcfpat5\chcbpat5 1\uc0\u1057 :\~\uc0\u1055 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1103 \uc0\u1090 \uc0\u1080 \uc0\u1077 :\~\uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1094 \uc0\u1072 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1100 \~\uc0\u1074 \~\uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1077 }}\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1044 \uc0\u1086 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1073 \uc0\u1086  \uc0\u1084 \uc0\u1085 \uc0\u1077 }\cell\pard\intbl\itap1\sl260{\fs18 \uc0\u1047 \uc0\u1072  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072 \uc0\u1093  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1080 \uc0\u1083  \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1096 \uc0\u1086 \uc0\u1081  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089  \uc0\u1083 \uc0\u1102 \uc0\u1076 \uc0\u1100 \uc0\u1084 \uc0\u1080 , \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1072  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1103 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 ; \uc0\u1090 \uc0\u1072 \uc0\u1082  \uc0\u1078 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1096 \uc0\u1105 \uc0\u1083  \uc0\u1085 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1077  \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1086 \uc0\u1074  \uc0\u1082 \uc0\u1072 \uc0\u1089 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1099 \uc0\u1093  \uc0\u1091 \uc0\u1074 \uc0\u1077 \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 , \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1089  \uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084 \uc0\u1080 , \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1084 . {\line}\uc0\u1061 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1096 \uc0\u1080 \uc0\u1077  \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1100 \uc0\u1102 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1072 , \uc0\u1085 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1081 \uc0\u1082 \uc0\u1072  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1080 ( \uc0\u1050 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1100 \uc0\u1102 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1099 , \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1092 \uc0\u1086 \uc0\u1085 \uc0\u1099 (\uc0\u1089 \uc0\u1084 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1092 \uc0\u1086 \uc0\u1085 \uc0\u1099 ), \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1096 \uc0\u1077 \uc0\u1090 \uc0\u1099  \uc0\u1080  \uc0\u1090 .\uc0\u1076 .){\line}\uc0\u1054 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081 , \uc0\u1086 \uc0\u1090 \uc0\u1079 \uc0\u1099 \uc0\u1074 \uc0\u1095 \uc0\u1080 \uc0\u1074 \uc0\u1099 \uc0\u1081 , \uc0\u1076 \uc0\u1088 \uc0\u1091 \uc0\u1078 \uc0\u1077 \uc0\u1083 \uc0\u1102 \uc0\u1073 \uc0\u1085 \uc0\u1099 \uc0\u1081 }\cell\row\pard}