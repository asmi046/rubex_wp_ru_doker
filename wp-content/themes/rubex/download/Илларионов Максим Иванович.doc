 \cell\row}{\footerf{\footery320 {\rtlch\fcs1 \af0\afs20 \ltrch\fcs0 \f0\fs16\cf4 \uc0\u1056 \uc0\u1077 \uc0\u1079 \uc0\u1102 \uc0\u1084 \uc0\u1077  \uc0\u1086 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1086  12 \uc0\u1080 \uc0\u1102 \uc0\u1085 \uc0\u1103  2023 \uc0\u1074  11:15}}}{\footer{\footery320 {\rtlch\fcs1 \af0\afs20 \ltrch\fcs0 \f0\fs16\cf4 \uc0\u1048 \uc0\u1083 \uc0\u1083 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1052 \uc0\u1072 \uc0\u1082 \uc0\u1089 \uc0\u1080 \uc0\u1084   \uc0\u8226   \uc0\u1056 \uc0\u1077 \uc0\u1079 \uc0\u1102 \uc0\u1084 \uc0\u1077  \uc0\u1086 \uc0\u1073 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1086  12 \uc0\u1080 \uc0\u1102 \uc0\u1085 \uc0\u1103  2023 \uc0\u1074  11:15}}}\trowd\trpaddft3\trpaddt200\cellx1800\cellx9638 \pard\intbl\sb100{ {\*\shppict{\pict\jpegblip\picwgoal1425\pichgoal1900
